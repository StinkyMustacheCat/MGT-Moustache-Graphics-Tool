{
  "version": 3,
  "name": "02 · Foto en corazón",
  "metadata": {
    "author": "MGT",
    "license": "CC0-1.0",
    "description": "Plantilla de ejemplo: importa una imagen desde sus parámetros."
  },
  "seed": 1,
  "recommended": {
    "duration": 6,
    "aspect": "horizontal",
    "resolution": 1080
  },
  "resources": {},
  "html": "<svg width=\"0\" height=\"0\" aria-hidden=\"true\"><defs><clipPath id=\"heart\" clipPathUnits=\"objectBoundingBox\"><path d=\"M.5 .96 C.38 .83 0 .57 0 .3 C0 -.02 .38 -.06 .5 .2 C.62 -.06 1 -.02 1 .3 C1 .57 .62 .83 .5 .96 Z\"/></clipPath></defs></svg><div id=\"group\"><div id=\"frame\"><img id=\"photo\" data-mgt-image=\"photo\" alt=\"\"><div id=\"empty\">Importa tu imagen<br>desde el panel de parámetros</div></div></div>",
  "css": "#group{position:absolute;transform-origin:center}#frame{position:relative;width:100%;height:100%;overflow:hidden;background:#303445}#photo{width:100%;height:100%;object-fit:cover;display:block}#empty{position:absolute;inset:0;display:grid;place-items:center;text-align:center;color:white;font:32px Arial;padding:40px}",
  "parameters": [
    {
      "id": "photo",
      "label": "Tu imagen",
      "type": "image",
      "default": ""
    },
    {
      "id": "fit",
      "label": "Encaje",
      "type": "select",
      "default": "Cubrir",
      "options": [
        "Cubrir",
        "Contener"
      ]
    },
    {
      "id": "zoom",
      "label": "Zoom de la imagen",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 3,
      "step": 0.01,
      "control": "slider"
    },
    {
      "id": "panX",
      "label": "Encuadre horizontal (%)",
      "type": "number",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "panY",
      "label": "Encuadre vertical (%)",
      "type": "number",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "blur",
      "label": "Desenfoque (px)",
      "type": "number",
      "default": 0,
      "min": 0,
      "max": 20,
      "step": 0.5,
      "control": "slider"
    },
    {
      "id": "startX",
      "label": "Inicio X (%)",
      "type": "number",
      "default": 25,
      "min": -100,
      "max": 200,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "startY",
      "label": "Inicio Y (%)",
      "type": "number",
      "default": 50,
      "min": -100,
      "max": 200,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "endX",
      "label": "Final X (%)",
      "type": "number",
      "default": 75,
      "min": -100,
      "max": 200,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "endY",
      "label": "Final Y (%)",
      "type": "number",
      "default": 50,
      "min": -100,
      "max": 200,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "size",
      "label": "Tamaño del corazón",
      "type": "number",
      "default": 600,
      "min": 150,
      "max": 1000,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "inside",
      "label": "Movimiento interior (%)",
      "type": "number",
      "default": 20,
      "min": -50,
      "max": 50,
      "step": 1,
      "control": "slider"
    }
  ],
  "stops": [
    {
      "id": "start",
      "label": "Inicio",
      "element": "#group",
      "x": "startX",
      "y": "startY",
      "at": 0
    },
    {
      "id": "end",
      "label": "Final",
      "element": "#group",
      "x": "endX",
      "y": "endY",
      "at": 1
    }
  ],
  "render": "const p=ctx.params,g=ctx.root.querySelector('#group'),f=ctx.root.querySelector('#frame'),img=ctx.root.querySelector('#photo');ctx.root.style.backgroundColor='#141323';ctx.root.querySelector('#empty').style.display=ctx.image(p.photo)?'none':'grid';img.style.objectFit=p.fit==='Contener'?'contain':'cover';img.style.objectPosition=p.panX+'% '+p.panY+'%';img.style.transform='scale('+p.zoom+')';img.style.transformOrigin=p.panX+'% '+p.panY+'%';img.style.filter='blur('+p.blur+'px)';const t=ctx.progress*ctx.progress*(3-2*ctx.progress);Object.assign(g.style,{width:p.size+'px',height:p.size+'px',left:(p.startX+(p.endX-p.startX)*t)*ctx.width/100+'px',top:(p.startY+(p.endY-p.startY)*t)*ctx.height/100+'px',transform:'translate(-50%,-50%)'});f.style.clipPath='url(#heart)';img.style.objectPosition=Math.max(0,Math.min(100,p.panX+(t-.5)*p.inside))+'% '+p.panY+'%';"
}