{
  "version": 4,
  "name": "GIF · transparencia y tiempo propio",
  "parameters": [
    {
      "id": "gifFile",
      "label": "GIF · archivo GIF",
      "type": "gif",
      "default": "demoGIF"
    },
    {
      "id": "gifX",
      "label": "GIF · posición X (%)",
      "type": "number",
      "default": 50,
      "min": -100,
      "max": 200,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "gifY",
      "label": "GIF · posición Y (%)",
      "type": "number",
      "default": 50,
      "min": -100,
      "max": 200,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "gifWidth",
      "label": "GIF · anchura (%)",
      "type": "number",
      "default": 70,
      "min": 1,
      "max": 200,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "gifHeight",
      "label": "GIF · altura (%)",
      "type": "number",
      "default": 70,
      "min": 1,
      "max": 200,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "gifAngle",
      "label": "GIF · giro (°)",
      "type": "number",
      "default": 0,
      "min": -360,
      "max": 360,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "gifOpacity",
      "label": "GIF · opacidad",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "control": "slider"
    },
    {
      "id": "gifFit",
      "label": "GIF · ajuste",
      "type": "select",
      "default": "contain",
      "options": [
        "contain",
        "cover",
        "fill"
      ]
    },
    {
      "id": "gifVisible",
      "label": "GIF · mostrar",
      "type": "boolean",
      "default": true
    }
  ],
  "html": "<canvas id=\"gifVisual\" data-mgt-gif=\"gifFile\"></canvas>",
  "css": "#gifVisual{position:absolute;transform:translate(-50%,-50%);pointer-events:none}",
  "render": "const {root,params:p,width,height}=ctx;const el=root.querySelector('#gifVisual');Object.assign(el.style,{left:p.gifX+'%',top:p.gifY+'%',width:p.gifWidth+'%',height:p.gifHeight+'%',objectFit:p.gifFit,opacity:p.gifOpacity,display:p.gifVisible?'block':'none',transform:'translate(-50%,-50%) rotate('+p.gifAngle+'deg)'});",
  "gifs": {
    "demoGIF": {
      "name": "gif-prueba.gif",
      "mime": "image/gif",
      "data": ""
    }
  },
  "recommended": {
    "duration": 3,
    "aspect": "horizontal",
    "resolution": 720
  }
}
