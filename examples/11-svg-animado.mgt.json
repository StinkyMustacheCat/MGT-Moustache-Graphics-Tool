{
  "version": 4,
  "name": "SVG · reloj y final declarable",
  "parameters": [
    {
      "id": "svgFile",
      "label": "SVG animado · archivo SVG animado",
      "type": "svgAnimation",
      "default": "demoSVG"
    },
    {
      "id": "svgX",
      "label": "SVG animado · posición X (%)",
      "type": "number",
      "default": 50,
      "min": -100,
      "max": 200,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "svgY",
      "label": "SVG animado · posición Y (%)",
      "type": "number",
      "default": 50,
      "min": -100,
      "max": 200,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "svgWidth",
      "label": "SVG animado · anchura (%)",
      "type": "number",
      "default": 70,
      "min": 1,
      "max": 200,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "svgHeight",
      "label": "SVG animado · altura (%)",
      "type": "number",
      "default": 70,
      "min": 1,
      "max": 200,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "svgAngle",
      "label": "SVG animado · giro (°)",
      "type": "number",
      "default": 0,
      "min": -360,
      "max": 360,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "svgOpacity",
      "label": "SVG animado · opacidad",
      "type": "number",
      "default": 1,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "control": "slider"
    },
    {
      "id": "svgFit",
      "label": "SVG animado · ajuste",
      "type": "select",
      "default": "contain",
      "options": [
        "contain",
        "cover",
        "fill"
      ]
    },
    {
      "id": "svgVisible",
      "label": "SVG animado · mostrar",
      "type": "boolean",
      "default": true
    },
    {
      "id": "svgEnd",
      "label": "Al terminar",
      "type": "select",
      "default": "hold",
      "options": [
        "hold",
        "loop",
        "hide"
      ]
    }
  ],
  "html": "<canvas id=\"svgVisual\" data-mgt-svg=\"svgFile\"></canvas>",
  "css": "#svgVisual{position:absolute;transform:translate(-50%,-50%);pointer-events:none}",
  "render": "const {root,params:p,width,height}=ctx;const el=root.querySelector('#svgVisual');Object.assign(el.style,{left:p.svgX+'%',top:p.svgY+'%',width:p.svgWidth+'%',height:p.svgHeight+'%',objectFit:p.svgFit,opacity:p.svgOpacity,display:p.svgVisible?'block':'none',transform:'translate(-50%,-50%) rotate('+p.svgAngle+'deg)'});",
  "animatedSVGs": {
    "demoSVG": {
      "name": "svg-prueba.svg",
      "mime": "image/svg+xml",
      "data": ""
    }
  },
  "recommended": {
    "duration": 3,
    "aspect": "horizontal",
    "resolution": 720
  },
  "playback": {
    "svgFile": {
      "end": {
        "param": "svgEnd"
      }
    }
  }
}
