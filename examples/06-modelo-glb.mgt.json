{
  "version": 4,
  "name": "GLB · modelo con textura",
  "parameters": [
    {
      "id": "cameraX",
      "label": "Cámara · posición X",
      "type": "number",
      "default": 0,
      "min": -2000,
      "max": 2000,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "cameraY",
      "label": "Cámara · posición Y",
      "type": "number",
      "default": 0,
      "min": -2000,
      "max": 2000,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "cameraDistance",
      "label": "Cámara · distancia",
      "type": "number",
      "default": 1600,
      "min": 500,
      "max": 5000,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "cameraYaw",
      "label": "Cámara · giro horizontal (°)",
      "type": "number",
      "default": 0,
      "min": -90,
      "max": 90,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "cameraPitch",
      "label": "Cámara · inclinación (°)",
      "type": "number",
      "default": 0,
      "min": -60,
      "max": 60,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "cameraRoll",
      "label": "Cámara · rotación (°)",
      "type": "number",
      "default": 0,
      "min": -180,
      "max": 180,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "cameraFov",
      "label": "Cámara · campo de visión (°)",
      "type": "number",
      "default": 45,
      "min": 15,
      "max": 100,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "modelPositionX",
      "label": "Modelo · position X",
      "type": "number",
      "default": 0,
      "min": -1500,
      "max": 1500,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "modelPositionY",
      "label": "Modelo · position Y",
      "type": "number",
      "default": 0,
      "min": -1500,
      "max": 1500,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "modelPositionZ",
      "label": "Modelo · position Z",
      "type": "number",
      "default": 0,
      "min": -1500,
      "max": 1500,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "modelRotationX",
      "label": "Modelo · rotation X",
      "type": "number",
      "default": 0,
      "min": -360,
      "max": 360,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "modelRotationY",
      "label": "Modelo · rotation Y",
      "type": "number",
      "default": 0,
      "min": -360,
      "max": 360,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "modelRotationZ",
      "label": "Modelo · rotation Z",
      "type": "number",
      "default": 0,
      "min": -360,
      "max": 360,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "modelScaleX",
      "label": "Modelo · scale X",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 4,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "modelScaleY",
      "label": "Modelo · scale Y",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 4,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "modelScaleZ",
      "label": "Modelo · scale Z",
      "type": "number",
      "default": 1,
      "min": 0.1,
      "max": 4,
      "step": 0.1,
      "control": "slider"
    },
    {
      "id": "modelSize",
      "label": "Modelo · tamaño inicial",
      "type": "number",
      "default": 500,
      "min": 50,
      "max": 2000,
      "step": 1,
      "control": "slider"
    },
    {
      "id": "modelVisible",
      "label": "Modelo · visible",
      "type": "boolean",
      "default": true
    },
    {
      "id": "modelFile",
      "label": "Modelo · archivo GLB",
      "type": "model",
      "default": "cube"
    }
  ],
  "html": "",
  "css": "",
  "render": "",
  "scene3d": {
    "version": 1,
    "camera": {
      "x": {
        "param": "cameraX"
      },
      "y": {
        "param": "cameraY"
      },
      "distance": {
        "param": "cameraDistance"
      },
      "yaw": {
        "param": "cameraYaw"
      },
      "pitch": {
        "param": "cameraPitch"
      },
      "roll": {
        "param": "cameraRoll"
      },
      "fov": {
        "param": "cameraFov"
      }
    },
    "objects": [
      {
        "id": "model",
        "type": "model",
        "resource": {
          "param": "modelFile"
        },
        "position": {
          "x": {
            "param": "modelPositionX"
          },
          "y": {
            "param": "modelPositionY"
          },
          "z": {
            "param": "modelPositionZ"
          }
        },
        "rotation": {
          "x": {
            "param": "modelRotationX"
          },
          "y": {
            "param": "modelRotationY"
          },
          "z": {
            "param": "modelRotationZ"
          }
        },
        "scale": {
          "x": {
            "param": "modelScaleX"
          },
          "y": {
            "param": "modelScaleY"
          },
          "z": {
            "param": "modelScaleZ"
          }
        },
        "width": {
          "param": "modelSize"
        },
        "visible": {
          "param": "modelVisible"
        }
      }
    ]
  },
  "models": {
    "cube": {
      "name": "cubo-material.glb",
      "mime": "model/gltf-binary",
      "data": ""
    }
  },
  "recommended": {
    "duration": 3,
    "aspect": "horizontal",
    "resolution": 720
  }
}